# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=flux-pro-2
AZURE_FLUX_KONTEXT_DEPLOYMENT_NAME=flux-kontext
# Exact name of the existing GPT Image 2.5 deployment (Sunburst or Flare).
# Uses the same AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_API_KEY as FLUX.
AZURE_GPT_IMAGE_DEPLOYMENT_NAME=your-gpt-image-deployment-name

# Azure Functions Configuration
FUNCTIONS_WORKER_RUNTIME=python
AzureWebJobsStorage=UseDevelopmentStorage=true
